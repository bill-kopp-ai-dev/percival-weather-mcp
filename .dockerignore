# Only inputs copied by the Dockerfile enter the context.
**
!pyproject.toml
!uv.lock
!README.md
!LICENSE
!CHANGELOG.md
!mcp.yaml
!docker-entrypoint.sh
!src/
!src/**

# Docker build context excludes. Keep the runtime image as small as possible
# while still bundling everything the FastMCP server needs at runtime.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
build/
dist/
.idea/
.vscode/
.DS_Store
*.log
.env
.env.*
!.env.example
secrets/
logs/
.cache/
.git/
.dockerignore
Dockerfile
docker-compose*.yml

# Tests, agent notes and registries do not belong in the runtime image.
tests/
docs/docker-mcp-packaging.md
docs/mcp/
.positronic/
AGENTS.md

# Git/CI metadata
.git/
.gitignore
.github/

# Editor backups and tooling caches
*.swp
*.bak

# Apply the state/secret boundary inside copied source trees too.
**/.venv/
**/.positronic/
**/.env
**/.env.*
**/secrets/
**/*.pem
**/*.key
**/__pycache__/
**/.cache/
**/AGENTS.md
**/.pytest_cache/
**/node_modules/
**/tests/
